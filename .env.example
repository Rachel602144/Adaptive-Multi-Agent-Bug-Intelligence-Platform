# Copy to .env — NEVER commit .env
GOOGLE_API_KEY=your_own_gemini_key
GEMINI_MODEL=gemini-2.5-flash
# Leave empty to use local SQLite; set to Neon URL for production
DATABASE_URL=
FRONTEND_ORIGIN=*
PIPELINE_MODE=adaptive
# Optional — stretch free-tier quota (20 requests/day per key per model):
# GOOGLE_API_KEYS=key1,key2,key3
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# OPENROUTER_API_KEY=your_openrouter_key   (fallback after Gemini; free models)
